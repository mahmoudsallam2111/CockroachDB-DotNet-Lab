<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core provider for the PostgreSQL wire protocol (CockroachDB speaks it) -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Swagger: generates the OpenAPI document (swagger.json) and serves Swagger UI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
    <!-- Carter: discovers ICarterModule classes and maps their endpoints -->
    <PackageReference Include="Carter" Version="10.0.0" />
    <!-- Design-time only: lets `dotnet ef` create migrations -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
